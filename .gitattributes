# Enforce LF: CRLF pollutes tests/ingest/fixtures and shifts the corpus content hash
# (snapshotId must be identical across platforms).
* text=auto eol=lf

# Git hooks must stay LF: a CRLF `#!/bin/sh` script dies with "bad interpreter" on macOS and in
# Git Bash, and the error shows up as "cannot commit" rather than as a line-ending problem.
/.githooks/* text eol=lf

# Binary assets bypass newline conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.parquet binary
*.safetensors binary
*.bin binary
*.onnx binary

# Note: tests/ingest/fixtures/ contains raw EUC-JP / Shift_JIS samples (used to test charset
# fallbacks). That directory must not carry working-tree-encoding and must not be re-encoded by
# an editor's "fix encoding" action.
