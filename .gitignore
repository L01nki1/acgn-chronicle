# ---- Data (invariant 6 of spec 02: data/ never enters git) ----
# raw/ holds full article bodies (internal retrieval only); index/ and snapshots/ are rebuildable.
/data/*
!/data/.gitkeep

# ---- Credentials and local configuration ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
ENV/
site/

# ---- Tool caches ----
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Notebooks ----
.ipynb_checkpoints/
*.nbconvert.ipynb

# ---- Model and embedding caches (large, downloadable again) ----
.cache/
.hf/
models/
*.safetensors
*.bin
*.onnx

# ---- Runtime artifacts (note: eval/qa_set.jsonl and eval/runs/ MUST stay tracked) ----
logs/
*.log
/tmp/

# ---- Frontend ----
node_modules/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Internal working notes (team convention: not committed; delete this line to include) ----
/PLAN.md
/.workbuddy/
