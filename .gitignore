# ---- 数据（02 不变量 6：data/ 永不进 git）----
# raw/ 原文区仅内部检索，永不对外；index/ 与 snapshots/ 由脚本可重建
/data/*
!/data/.gitkeep

# ---- 凭证与本地配置 ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
ENV/
site/

# ---- 工具缓存 ----
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Notebook ----
.ipynb_checkpoints/
*.nbconvert.ipynb

# ---- 模型与编码缓存（体积大，可重下）----
.cache/
.hf/
models/
*.safetensors
*.bin
*.onnx

# ---- 运行时产物（注意：eval/qa_set.jsonl 与 eval/runs/ 必须进 git）----
logs/
*.log
/tmp/

# ---- 前端 ----
node_modules/

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 内部工作文档（组内约定：不进版本库；需要提交时删掉这一行）----
/PLAN.md
/.workbuddy/
