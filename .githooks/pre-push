#!/bin/sh
# Full gate before anything leaves the machine: the same four steps CI runs, in the same order.
# See docs/ONBOARDING.md 4.1 for what each gate catches.
#
# Install once per clone: python scripts/install_hooks.py
# Bypass (CI will catch it later, and the run is public): git push --no-verify

set -eu

if [ -t 1 ] && [ -n "${TERM:-}" ]; then
    YELLOW=$(printf '\033[33m'); RESET=$(printf '\033[0m')
else
    YELLOW=''; RESET=''
fi

warn() { printf '%s%s%s\n' "$YELLOW" "[pre-push] $*" "$RESET"; }

PY=''
# uv path: provision the project .venv from the lock if it does not exist yet (same as pre-commit).
if command -v uv >/dev/null 2>&1 && [ -f uv.lock ] && [ ! -x .venv/bin/python ]; then
    uv sync --frozen --extra dev >/dev/null 2>&1 || true
fi
for candidate in .venv/Scripts/python.exe .venv/bin/python python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then PY="$candidate"; break; fi
done

if [ -z "$PY" ]; then
    warn "no Python interpreter found - skipping local gates (CI still gates this)."
    exit 0
fi

if ! "$PY" -m pytest --version >/dev/null 2>&1; then
    warn "pytest is not installed for $PY - skipping local gates (CI still gates this)."
    warn "install it with: uv sync --extra dev (or pip install -e \".[dev]\")"
    exit 0
fi

exec "$PY" scripts/check.py
