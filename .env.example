# 复制成 .env 后填写；.env 永不提交（见 .gitignore）
# 变量名与 src/acgn_rag/config.py 一一对应，改一处必须改两处。

# ---- 运行环境 ----
ACGN_ENV=local
# 数据根目录（整目录被 gitignore；换机器/换平台各自重建）
ACGN_DATA_DIR=data

# ---- Embedding（开源模型，本地跑，不走 API）----
# e5 系列必须加 query:/passage: 前缀，代码已内置，不要绕过
ACGN_EMBED_MODEL=intfloat/multilingual-e5-base
# 评测与建索引统一 cpu：跨机器（mac arm64 / x86）向量才可比
ACGN_EMBED_DEVICE=cpu
ACGN_EMBED_BATCH=32

# ---- LLM：抽取线与生成线允许用不同厂商 ----
# 抽取线（F，W2 批量：要便宜、JSON 稳、可重试）
ACGN_EXTRACT_BASE_URL=
ACGN_EXTRACT_API_KEY=
ACGN_EXTRACT_MODEL=

# 生成线（B，W3 起在线：要指令遵循 + 引用编号不编 + 拒答）
ACGN_ANSWER_BASE_URL=
ACGN_ANSWER_API_KEY=
ACGN_ANSWER_MODEL=

# 兼容旧变量：上面两组留空时回落到这三个
ACGN_LLM_BASE_URL=
ACGN_LLM_API_KEY=
ACGN_LLM_MODEL=
ACGN_LLM_MODEL_VERSION=

# ---- 采集（01 §5.2）----
# 自描述 UA 是合规姿态，不要伪装成浏览器
ACGN_HTTP_UA=
ACGN_HTTP_TIMEOUT=10
ACGN_HTTP_CONCURRENCY=8

# ---- 存储（D4：Chroma 基线）----
ACGN_STORE_BACKEND=chroma
ACGN_KEEP_SNAPSHOTS=2
# 过滤后不足 top_k 的兜底倍数（Chroma where-filter 会裁掉候选）
ACGN_OVERFETCH=5
