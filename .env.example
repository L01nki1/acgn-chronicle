# Copy to .env and fill in. .env is never committed (see .gitignore).
# Variable names map 1:1 to src/acgn_rag/config.py - change both or neither.

# ---- Runtime ----
ACGN_ENV=local
# Data root (the whole directory is gitignored; rebuild it per machine)
ACGN_DATA_DIR=data

# ---- Embedding (open-source model, runs locally, no API) ----
# e5 models require the query:/passage: prefixes; the code adds them, do not bypass it
ACGN_EMBED_MODEL=intfloat/multilingual-e5-base
# Indexing and evaluation both use cpu so vectors stay comparable across machines
ACGN_EMBED_DEVICE=cpu
ACGN_EMBED_BATCH=32

# ---- LLM: the extraction line and the answer line may use different vendors ----
# Extraction (F, W2 batch: cheap, strict JSON, retryable)
ACGN_EXTRACT_BASE_URL=
ACGN_EXTRACT_API_KEY=
ACGN_EXTRACT_MODEL=

# Answer generation (B, W3 onwards: instruction following, no invented citations, abstention)
ACGN_ANSWER_BASE_URL=
ACGN_ANSWER_API_KEY=
ACGN_ANSWER_MODEL=

# Backward-compatible fallback: used when the two groups above are empty
ACGN_LLM_BASE_URL=
ACGN_LLM_API_KEY=
ACGN_LLM_MODEL=
ACGN_LLM_MODEL_VERSION=

# ---- Crawling (01 §5.2) ----
# A self-describing UA is a compliance stance: never disguise the bot as a browser
ACGN_HTTP_UA=
ACGN_HTTP_TIMEOUT=10
ACGN_HTTP_CONCURRENCY=8

# ---- Storage (D4: Chroma baseline) ----
ACGN_STORE_BACKEND=chroma
ACGN_KEEP_SNAPSHOTS=2
# Over-fetch factor: a where-filter can return fewer rows than top_k
ACGN_OVERFETCH=5
